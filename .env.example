PORT=5000
NODE_ENV=development
FRONTEND_URL=https://frontend-sample-model.vercel.app
CORS_ORIGINS=https://frontend-sample-model.vercel.app,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

DB_PORT=27017
DB_URL=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_URL>/<DATABASE_NAME>?retryWrites=true&w=majority


API_VERSION=1.1.0

AUTH_EXPIRES=1d
JWT_SECRET=your_super_secret_jwt_key_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

API_PROCESS=
